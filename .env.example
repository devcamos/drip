# Preview and Production must use separate databases and secrets.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Use the stable branch URL for Preview. Passkeys belong to that hostname.
# Server-only incident alerts. Separate Preview/Production secrets; never NEXT_PUBLIC_.
DRIP_INCIDENTS_ENABLED=false
DRIP_INCIDENT_SIGNING_SECRET=
# Incoming webhook bound to #incidents in the Nexus Slack workspace.
DRIP_INCIDENT_SLACK_WEBHOOK_URL=
