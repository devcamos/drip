{
  "name": "drip",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "validate:deployment": "node scripts/validate-deployment.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project integration --coverage",
    "test:unit": "vitest run --project unit",
    "test:components": "vitest run --project integration",
    "test:policy": "node tools/regression/check.mjs",
    "test:regression": "node tools/regression/run.mjs",
    "test:cloud-browser": "node tools/regression/cloud.mjs",
    "e2e": "playwright test",
    "audit": "npm audit --audit-level=high",
    "postinstall": "node tools/depcruise/link-bin.mjs",
    "depcruise": "depcruise app lib server --output-type err",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:calendar:unit": "vitest run --config vitest.calendar.config.mts --project calendar-unit",
    "test:calendar:integration": "vitest run --config vitest.calendar.config.mts --project calendar-integration",
    "test:calendar:e2e": "playwright test e2e/payment-calendar.e2e.spec.ts",
    "test:calendar": "npm run test:calendar:unit && npm run test:calendar:integration && npm run test:calendar:e2e"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.18",
    "@neondatabase/serverless": "1.2.0",
    "better-auth": "1.7.18",
    "https-proxy-agent": "9.1.0",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "web-push": "3.6.7",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/parser": "8.1.0",
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "3.6.4",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.1.0",
    "drip-depcruise": "file:tools/depcruise",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^30.1.3",
    "typescript": "^7.0",
    "vite": "8.3.6",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "postcss": "^8.5.30",
    "compression": "^1.8.2"
  },
  "engines": {
    "node": "24.x"
  }
}
